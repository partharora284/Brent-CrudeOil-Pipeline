# Copy to .env (Copy-Item .env.example .env). Relative paths resolve from the project root.
# NEVER commit .env - it may hold API keys.

# --- Data locations ---
RAW_DATA_DIR=data/raw
FEATURE_STORE_PATH=data/feature_store.duckdb   # DuckDB (was feature_store.db / SQLite)
MODEL_DIR=models

# --- Modelling ---
FORECAST_HORIZON=1        # MUST stay 1: the target is "current session at or above previous settlement"
TRAIN_FRACTION=0.8
CONF_UPPER=0.55           # P(Up) >= this -> BULL
CONF_LOWER=0.45           # P(Up) <= this -> BEAR
N_SEARCH_ITER=20
RANDOM_STATE=42
LOOKBACK_DAYS=60

# --- Experimental demo mode ---
# 0 (default) = strict: only a model that PASSED the validation gate is served.
# 1 = if nothing is approved, serve the newest REJECTED model that is complete and trained for the current daily target.
#     The API and dashboard then show a permanent warning. Restart the API after changing this.
ALLOW_UNVALIDATED_MODEL=0

# --- Backend / dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
STALE_DAYS=4              # used by /health only; the session logic (src/sessions.py) decides what the dashboard says
DASHBOARD_REFRESH_SECONDS=300   # dashboard re-asks the API at most this often

# --- Live market data (no API key needed for yahoo) ---
DATA_PROVIDER=yahoo       # yahoo (default) | fred (closes only, not enough for the model) | none (CSV files only)
# Yahoo symbols (unofficial free source). Change if a symbol stops working; the job tells you which input failed.
YAHOO_BRENT_SYMBOL=BZ=F
YAHOO_WTI_SYMBOL=CL=F
YAHOO_DXY_SYMBOL=DX-Y.NYB
PROVIDER_MAX_OVERLAP_DIFF=0.05  # reject a live series whose prices differ from the CSV history by more than 5% (median)
MAX_ASSET_LAG_DAYS=3      # an input (WTI/DXY) older than Brent by more than this -> no prediction
MARKET_TZ=America/New_York      # a daily bar counts as finished only when its date is before today in this zone
MARKET_HOLIDAYS=          # extra closed days, e.g. 2026-12-28,2027-05-31 (25 Dec, 1 Jan, Good Friday are built in)

# --- Optional, only for DATA_PROVIDER=fred ---
FRED_API_KEY=
